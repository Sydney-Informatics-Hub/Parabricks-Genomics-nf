// Use with nextflow run main.nf ... -profile gadi,pipe7729
//
// Everything here is additive. Without this profile the pipeline runs the minimal,
// justified set in modules/annotate_vcf.nf and nothing below applies.
//
// Two paths are involved and neither is a Nextflow input, so neither is bound by
// singularity.autoMounts (which binds only the collapsed common parent of the work dir
// and the staged inputs). containerOptions supplies the binds; it is appended to the
// auto-generated -B list, not substituted for it.
//
//   vep_plugins_dir  the release/116 .pm clone. MUST match the container's VEP release -
//                    plugin code is versioned with the cache. Never point this at if89,
//                    whose .pm files are ~114 vintage.
//   vep_plugin_db    if89's read-only data library. Not ours; treat as provisional.
//   vep_plugin_data  data we acquired ourselves (see reference/setup_*.pbs).

params {
    vep_plugins_dir = '/scratch/er01/PIPE-7729-wes-wgs/reference/vep_plugins'
    vep_plugin_db   = '/g/data/if89/data_library/VEP_data/VEP_plugin_db'
    vep_plugin_data = '/scratch/er01/PIPE-7729-wes-wgs/reference/vep_plugin_data'

    // Passed through to vep by modules/annotate_vcf.nf. This is a params value rather
    // than an ext.args as `ext` is not part of Nextflow's task hash, so will not be resumable
    vep_extra_args = [
        "--dir_plugins ${params.vep_plugins_dir}",

        // Loss of function: does the variant trigger nonsense-mediated decay? Feeds the
        // PVS1 decision tree. No data file.
        "--plugin NMD",

        // Missense pathogenicity (PP3/BP4).
        "--plugin AlphaMissense,file=${params.vep_plugin_db}/AlphaMissense_hg38.tsv.gz",
        "--plugin REVEL,file=${params.vep_plugin_data}/new_tabbed_revel_grch38.tsv.gz",
        "--plugin CADD,snv=${params.vep_plugin_data}/CADD_v1.7/whole_genome_SNVs.tsv.gz,indels=${params.vep_plugin_data}/CADD_v1.7/gnomad.genomes.r4.0.indel.tsv.gz",

        // Splicing (PP3/BP4).
        //
        // SpliceAI comes in as --custom, NOT --plugin. if89's file is a custom-reduced
        // build whose INFO is "AG=0.00;AL=0.00;DG=0.04;DL=0.00", while SpliceAI.pm
        // (parse_data, line 326-331) expects the official pipe-delimited
        // "SpliceAI=ALLELE|SYMBOL|DS_AG|...". The plugin therefore emits "uninitialized
        // value" warnings and every SpliceAI_* field comes back empty. Verified on a
        // chr22 subset: 0 of 10,964 populated.
        "--custom file=${params.vep_plugin_db}/spliceai_scores.masked.snv.indel.sort.reduced.hg38.vcf.gz,short_name=SpliceAI,format=vcf,type=exact,coords=0,fields=AG%AL%DG%DL",
        "--plugin dbscSNV,${params.vep_plugin_db}/dbscSNV1.1_GRCh38.txt.gz",
        "--plugin MaxEntScan,${params.vep_plugin_db}/MaxEntScan,SWA,NCSS",

        // Non-coding and regulatory. Only meaningful on genomes so excluded when using --exome.
        params.exome ? '' : "--regulatory",
        params.exome ? '' : "--plugin UTRAnnotator,file=${params.vep_plugin_db}/uORF_starts_ends_GRCh38_PUBLIC.txt",
        params.exome ? '' : "--plugin Enformer,file=${params.vep_plugin_data}/enformer_grch38.vcf.gz",
    ].findAll{ it }.join(' ')
}

process {
    withName: annotate_vcf {

        // PBS must grant the job gdata/if89 or the bind below fails outright. A withName
        // selector beats the generic `storage` in config/gadi.config regardless of config
        // include order, which setting params.storage_account from here would not:
        // gadi.config interpolates that param when its own file is parsed.
        storage = 'scratch/er01+gdata/if89'

        containerOptions = "-B ${params.vep_plugin_db} -B ${params.vep_plugins_dir} -B ${params.vep_plugin_data}"

        // Plugin lookups are random tabix reads across /g/data and /scratch Lustre, 8-way
        // forked, once per variant - CADD's 81 GiB table most of all. The 4 h default in
        // config/modules.config is not safe for the chr1/chr2 shards. Retune from the
        // gadi trace after the first run rather than guessing again.
        time = { 12.h * task.attempt }
    }
}
